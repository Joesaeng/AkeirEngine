{
  "$schema": "game://schema/test/1",
  "name": "CombatCapture",
  "description": "Golden-image regression of the arena after 300 ticks (§27.1). Software rasterizer, 256x256. Regenerate with `game test Visual --update-golden` when the look changes on purpose.",
  "requires": ["renderer"],
  "seed": 381251,
  "setup": [ { "entity": "path:TestArena/Arena/Player", "as": "player" } ],
  "run": { "ticks": 300 },
  "assert": [
    { "id": "player-alive", "expr": "player.Health.current > 0", "at": "end" },
    { "id": "golden-end", "capture": { "width": 256, "height": 256, "golden": "combat_end", "tolerance": { "perPixel": 0.1, "maxMismatchRatio": 0.002 } }, "at": "end" },
    { "id": "shot-150", "capture": { "width": 256, "height": 256 }, "at": 150 }
  ]
}
